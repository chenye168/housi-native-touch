<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key><string>local.housitouch.setmode</string>
    <key>ProgramArguments</key><array>
      <string>/usr/bin/open</string>
      <string>-g</string>
      <string>-j</string>
      <string>-a</string>
      <string>/Applications/HOUSITouchHelper.app</string>
    </array>
    <key>RunAtLoad</key><true/>
    <key>KeepAlive</key><false/>
    <key>ThrottleInterval</key><integer>5</integer>
    <key>StandardOutPath</key><string>/tmp/housitouch-setmode.out</string>
    <key>StandardErrorPath</key><string>/tmp/housitouch-setmode.err</string>
</dict>
</plist>
